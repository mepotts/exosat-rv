.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Scoped local agent/pytest scratch roots (never evidence or source artifacts).
/.codex-*-tests/
# Downloaded ESO products: large, re-fetchable, and not ours to redistribute.
data/spectra/
data/cr2res/
data/cr2res_tpl/
data/raw/
*.fits
*.fits.Z
# Archived papers: fetched from arXiv, not ours to redistribute. The extracted
# text under papers/text/ IS committed -- it is what the milestones cite.
papers/pdf/
papers/text/abs.html

# --- Carried from the monorepo root -------------------------------------------
# This project lived in mepotts/astronomy, whose root .gitignore was an explicit
# "safety net at the portfolio root" that every subproject leaned on. The split took
# this file but not that one, so these rules -- the secret patterns above all -- were
# silently lost. Restored here.
node_modules/
venv/
*.py[cod]
.mypy_cache/
dist/
build/
# Secrets
.env
.env.*
*.token
*.key
# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Logs (esorex writes one into the repo root when run from here)
*.log
